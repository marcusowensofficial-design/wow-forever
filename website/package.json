{
  "name": "wow-forever-web",
  "version": "1.60.6",
  "private": true,
  "description": "World of Warcraft: Forever — Classic+ Beta Hub, Codex, BiS Planner & Character Tools",
  "type": "module",
  "scripts": {
    "dev": "npx serve . -l 3000",
    "start": "npx serve . -l 3000",
    "preview": "npx serve . -l 3000",
    "test": "node scripts/validate.js && node scripts/validate-atlas.js",
    "test:addons": "node scripts/validate-addons.mjs",
    "package:addons": "node scripts/package-addons.js",
    "lint": "npx eslint js/ scripts/",
    "build:data": "node scripts/compile-scraped-data.js",
    "scrape": "node scripts/scrape-foreverchanges.js",
    "pipeline:progression": "node scripts/cache-forever-items.mjs && node scripts/build-progression.mjs && node scripts/compile-progression-data.mjs && node scripts/validate.js"
  },
  "keywords": [
    "world-of-warcraft",
    "classic-plus",
    "talent-calculator",
    "bis-planner",
    "codex"
  ],
  "author": "Marcus Owens",
  "license": "UNLICENSED",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "playwright": "^1.64.0"
  }
}
